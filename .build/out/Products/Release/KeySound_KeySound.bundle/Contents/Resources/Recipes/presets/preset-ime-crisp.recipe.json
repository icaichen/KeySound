{
  "version": 2,
  "meta": {
    "name": "IME Crisp",
    "author": "Keysound",
    "description": "Input-method style crisp tick: Layer snap attack over a clean bright body.",
    "tags": ["crisp", "ime", "showcase"]
  },
  "layers": {
    "click": {
      "enabled": true,
      "gain": 0.9,
      "pitchShiftSt": 2,
      "trimMs": 25,
      "lowpassHz": 20000,
      "sample": { "pack": "Layer_Click_Snap", "file": "generic" }
    },
    "body": {
      "enabled": true,
      "gain": 0.8,
      "pitchShiftSt": 0,
      "trimMs": 0,
      "lowpassHz": 20000,
      "sample": { "pack": "Layer_Body_Crisp", "file": "generic" }
    },
    "release": {
      "enabled": false,
      "gain": 0.15,
      "pitchShiftSt": 6,
      "trimMs": 40,
      "lowpassHz": 20000,
      "sample": { "pack": "Layer_Release_Soft", "file": "generic" }
    },
    "space": {
      "enabled": false,
      "reverbWet": 0.1,
      "roomSize": 0.25,
      "stereoWidth": 0.7
    }
  },
  "master": {
    "gain": 1.0,
    "eq": { "lowDb": 0, "midDb": 0, "highDb": 0 }
  },
  "humanize": {
    "pitchJitterSt": 0.3,
    "gainJitterDb": 1.0,
    "timingJitterMs": 2
  },
  "keymap": {
    "space":     { "pitchShift": -2, "gainScale": 1.1, "decayScale": 1 },
    "enter":     { "pitchShift": 0, "gainScale": 1.05, "decayScale": 1 },
    "backspace": { "pitchShift": -1, "gainScale": 1.0, "decayScale": 1 },
    "modifier":  { "pitchShift": -2, "gainScale": 0.9, "decayScale": 1 },
    "keyPitchMode": "off"
  }
}
