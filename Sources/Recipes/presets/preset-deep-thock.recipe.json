{
  "version": 2,
  "meta": {
    "name": "Deep Thock",
    "author": "Keysound",
    "description": "Heavy deep thock: soft attack under a low body, gentle release on key up.",
    "tags": ["thock", "deep", "showcase"]
  },
  "layers": {
    "click": {
      "enabled": true,
      "gain": 0.35,
      "pitchShiftSt": 0,
      "trimMs": 30,
      "lowpassHz": 20000,
      "sample": { "pack": "Layer_Click_Soft", "file": "generic" }
    },
    "body": {
      "enabled": true,
      "gain": 1.0,
      "pitchShiftSt": 0,
      "trimMs": 0,
      "lowpassHz": 20000,
      "sample": { "pack": "Layer_Body_Thock", "file": "generic" }
    },
    "release": {
      "enabled": true,
      "gain": 0.2,
      "pitchShiftSt": 4,
      "trimMs": 40,
      "lowpassHz": 20000,
      "sample": { "pack": "Layer_Release_Soft", "file": "generic" }
    },
    "space": {
      "enabled": false,
      "reverbWet": 0.1,
      "roomSize": 0.25,
      "stereoWidth": 0.7
    }
  },
  "master": {
    "gain": 1.0,
    "eq": { "lowDb": 0, "midDb": 0, "highDb": 0 }
  },
  "humanize": {
    "pitchJitterSt": 0.4,
    "gainJitterDb": 1.5,
    "timingJitterMs": 2
  },
  "keymap": {
    "space":     { "pitchShift": -3, "gainScale": 1.15, "decayScale": 1 },
    "enter":     { "pitchShift": -1, "gainScale": 1.1, "decayScale": 1 },
    "backspace": { "pitchShift": -1, "gainScale": 1.0, "decayScale": 1 },
    "modifier":  { "pitchShift": -2, "gainScale": 0.9, "decayScale": 1 },
    "keyPitchMode": "off"
  }
}
