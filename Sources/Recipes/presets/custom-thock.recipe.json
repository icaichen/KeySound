{
  "version": 2,
  "meta": {
    "name": "Custom Thock",
    "author": "Keysound",
    "description": "Sample-based DJ board preset: Creamy click over a Thocky body.",
    "tags": ["thock", "showcase"]
  },
  "layers": {
    "click": {
      "enabled": false,
      "gain": 0.2,
      "pitchShiftSt": 3,
      "trimMs": 15,
      "lowpassHz": 20000,
      "sample": { "pack": "Creamy", "file": "generic" }
    },
    "body": {
      "enabled": true,
      "gain": 1.0,
      "pitchShiftSt": 0,
      "trimMs": 0,
      "lowpassHz": 20000,
      "sample": { "pack": "Thocky", "file": "generic" }
    },
    "release": {
      "enabled": false,
      "gain": 0.15,
      "pitchShiftSt": 6,
      "trimMs": 40,
      "lowpassHz": 20000,
      "sample": { "pack": "Creamy", "file": "generic" }
    },
    "space": {
      "enabled": false,
      "reverbWet": 0.1,
      "roomSize": 0.25,
      "stereoWidth": 0.7
    }
  },
  "master": {
    "gain": 1.0,
    "eq": { "lowDb": 0, "midDb": 0, "highDb": 0 }
  },
  "humanize": {
    "pitchJitterSt": 0.4,
    "gainJitterDb": 1.5,
    "timingJitterMs": 2
  },
  "keymap": {
    "space":     { "pitchShift": -2, "gainScale": 1.15, "decayScale": 1 },
    "enter":     { "pitchShift": 0.5, "gainScale": 1.1, "decayScale": 1 },
    "backspace": { "pitchShift": -1, "gainScale": 1.0, "decayScale": 1 },
    "modifier":  { "pitchShift": -2, "gainScale": 0.95, "decayScale": 1 },
    "keyPitchMode": "off"
  }
}
